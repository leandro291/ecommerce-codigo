# Neon
DATABASE_URL=""

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Firma de los webhooks de Clerk. Lo lee `verifyWebhook()` en
# `/api/webhooks/clerk` directamente del entorno. Formato: whsec_...
# De dónde sale: dashboard de Clerk → Webhooks → el endpoint
# https://<dominio>/api/webhooks/clerk → Signing Secret.
# En local, el secret es el del endpoint que da de alta
# `clerk webhooks listen --token "$(clerk webhooks token)" \
#   --forward-to http://localhost:3000/api/webhooks/clerk`.
# Sin esta variable el handler responde 400 a todos los eventos.
CLERK_WEBHOOK_SIGNING_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — pagos (Stripe Checkout). Detalle en docs/stripe/stripe-checkout.md §2.
# Clave restringida (rk_...), nunca la secreta (sk_...). Scopes mínimos:
# Checkout Sessions [write], PaymentIntents [read], Webhook Endpoints [read].
STRIPE_SECRET_KEY=""
# Firma de los webhooks de Stripe. La lee `stripe.webhooks.constructEvent()` en
# /api/webhooks/stripe. Formato: whsec_...
# En local sale de `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# En prod, del endpoint en Dashboard → Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=""

# Super admin — lo consume `npm run db:seed` para crear la fila en `users` y
# asignarle el puesto `super_admin`. Sin ambas variables el seed no falla: solo
# avisa que no hay super admin configurado.
# El clerk_id se copia del usuario en el dashboard de Clerk (formato user_...).
SUPER_ADMIN_CLERK_ID=""
SUPER_ADMIN_EMAIL=""
